[Unit]
Description=Radius Guard Discord Security
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/radius-guard
ExecStart=/home/ubuntu/radius-guard/.venv/bin/python server.py
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/radius-guard/data

[Install]
WantedBy=multi-user.target
